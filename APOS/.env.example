# COS Personal — انسخ إلى .env
COS_WORKSPACE=
COS_WATCH_INTERVAL_MS=800
COS_CONFIDENCE_MIN=0.55
COS_LEARN_MODE=1
COS_REQUIRE_CONFIRM_RISKY=1

# طبقة البيانات (اختياري)
COS_DATABASE_URL=
COS_REDIS_URL=redis://127.0.0.1:6379/0
COS_QDRANT_URL=
COS_QDRANT_COLLECTION=cos_experience
COS_VECTOR_DIM=384

# انفتاح عند الفشل
COS_AUTO_RESEARCH=1
COS_AUTO_RESEARCH_RETRIES=2
# افتراضي: لا تصعيد مدفوع لـ Claude إلا إذا فعّلته
COS_AUTO_CLAUDE_ESCALATE=0

# —— العقل (مجاني محلي أولاً) ——
# auto | llamacpp | ollama | openrouter | anthropic | rules
COS_BRAIN_PROVIDER=llamacpp
COS_LLAMA_CPP_HOST=http://127.0.0.1:8080
COS_LLAMA_CPP_MODEL=Qwen2.5-3B-Instruct-Q4_K_M.gguf
OLLAMA_HOST=http://127.0.0.1:11434
COS_OLLAMA_MODEL=qwen2.5:7b
COS_USE_BRAIN_PLANNER=1
COS_BRAIN_TIMEOUT=60
COS_BRAIN_MAX_TOKENS=700
# عقل أقوى للتوضيح/الخطط المعقّدة: auto يفضّل OpenRouter ثم Ollama ثم المحلي
COS_COMPLEX_BRAIN=auto
# قبل التنفيذ: يكرّر الفهم ويطلب نعم/لا
COS_CLARIFY_BEFORE_EXECUTE=1
# ذاكرة هدف/خطوات/حالة عبر الجولات
COS_SESSION_MEMORY=1

# اختياري مدفوع/مجاني عبر السحابة
OPENROUTER_API_KEY=
COS_OPENROUTER_MODEL=qwen/qwen2.5-7b-instruct:free
# ANTHROPIC_API_KEY=   (من جذر المشروع .env أيضاً)

# —— صوت ——
# auto | google | whisper — اللهجات عبر COS_STT_GOOGLE_LANGS
COS_STT_ENGINE=auto
# small أدق من base؛ medium أدق وأبطأ (يفضّل سماعات رأس)
COS_WHISPER_MODEL=small
# عراقية أولاً ثم فصحى/خليج/شام/مصر...
COS_STT_GOOGLE_LANGS=ar-IQ,ar-SA,ar-EG,ar-AE,ar-KW,ar-BH,ar-QA,ar-JO,ar-SY,ar-LB,ar-YE,ar-OM,ar-MA,ar
COS_STT_GOOGLE_MAX=6
COS_WHISPER_DEVICE=auto
COS_VOICE_BARGE_IN=0
# إحداثيات نسبية لمحرر/زر Backtest في QuantConnect (مسار الماوس الاحتياطي فقط)
COS_QC_EDITOR_RX=0.48
COS_QC_EDITOR_RY=0.45
COS_QC_BACKTEST_RX=0.88
COS_QC_BACKTEST_RY=0.18

# —— منفّذ QuantConnect المباشر (المسار الموصى به) ——
# من https://www.quantconnect.com/settings/ → Security
QC_USER_ID=
QC_API_TOKEN=
QC_PROJECT_NAME=MatrixRobotQC
COS_QC_PREFER_API=1
